# Wzór konfiguracji sklepu HAU — skopiuj do `.env` i uzupełnij.
# Prawdziwy `.env` NIGDY nie trafia do repozytorium (.gitignore).
#
# Gdzie co ustawiać przy wdrożeniu (patrz CLAUDE.md → „Wdrożenie”):
#  - NEXT_PUBLIC_*, CSP_MODE, SITE_INDEXABLE — wkompilowywane PRZY BUDOWANIU:
#    GitHub → Settings → Environments → <środowisko> (secrets / vars).
#  - pozostałe — w `.env` na serwerze, obok server.js (public_html/standalone/.env).
# Brakujące zmienne wypisuje log serwera przy starcie i /admin/settings.

# --- Adres sklepu ---
NEXT_PUBLIC_APP_URL=https://ehau.pl
NEXT_PUBLIC_BASE_URL=https://ehau.pl
# false = cały serwis noindex (staging); na produkcji usuń albo ustaw true
SITE_INDEXABLE=
# report-only (domyślnie) | enforce | off
CSP_MODE=

# --- Sanity ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-10-11
SANITY_API_TOKEN=
SANITY_API_READ_TOKEN=
SANITY_API_DEPLOY_TOKEN=
SANITY_PRICE_WEBHOOK_SECRET=

# --- MySQL / Redis ---
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
REDIS_URL=

# --- Clerk (na produkcji klucze pk_live_ / sk_live_) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_RESET_PASSWORD_URL=/reset-password
NEXT_PUBLIC_CLERK_VERIFY_EMAIL_URL=/verify-email

# --- Płatności: Autopay ---
AUTOPAY_SERVICE_ID=
AUTOPAY_HASH_KEY=
# test | production
AUTOPAY_ENV=test
AUTOPAY_BASE_URL=
AUTOPAY_HASH_ALGO=sha256
AUTOPAY_HASH_SEPARATOR=|
AUTOPAY_SEND_RETURN_URL=
# Formularz karty w ramce na stronie sklepu (ScreenType=IFRAME). Domyślnie wyłączony —
# włącz (true) tylko, jeśli Autopay potwierdzi tę usługę dla serwisu. Bez niej
# wszystkie płatności (BLIK, karta, przelew) idą przekierowaniem na stronę Autopay.
# BLIK-0 (white label) i płatności kartą One Click / recurring nie są dostępne na umowie.
AUTOPAY_CARD_IFRAME_ENABLED=

# --- Płatności: Przelewy24 ---
P24_MERCHANT_ID=
P24_POS_ID=
P24_API_KEY=
P24_CRC_KEY=

# --- Furgonetka ---
# sandbox | production — klucz mapy i dane OAuth muszą być z tego samego środowiska
NEXT_PUBLIC_FURGONETKA_ENV=sandbox
NEXT_PUBLIC_FURGONETKA_MAP_API_KEY=
FURGONETKA_CLIENT_ID=
FURGONETKA_CLIENT_SECRET=
FURGONETKA_REDIRECT_URI=http://localhost:3000/api/furgonetka/callback
# opcjonalny zapas — właściwy (rotowany) token żyje w Redisie po autoryzacji w panelu
FURGONETKA_REFRESH_TOKEN=
FURGONETKA_WEBHOOK_SECRET=

# --- Maile (SMTP) i newsletter ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NEWSLETTER_RATE_PER_MINUTE=20
NEWSLETTER_DAILY_LIMIT=400

# --- Zamówienia ---
ORDER_LINK_SECRET=
ORDER_PAYMENT_DEADLINE_HOURS=72
# Bearer dla /api/cron/price-history, /api/cron/unpaid-orders, /api/cron/newsletter-campaigns
CRON_SECRET=

# --- Analityka / SEO ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Dane sprzedawcy (wymóg prawny; w CI jako vars.SELLER_*) ---
NEXT_PUBLIC_SELLER_NAME=
NEXT_PUBLIC_SELLER_ADDRESS=
NEXT_PUBLIC_SELLER_NIP=
NEXT_PUBLIC_SELLER_REGISTRY=
NEXT_PUBLIC_SELLER_EMAIL=
NEXT_PUBLIC_SELLER_PHONE=
